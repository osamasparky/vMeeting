APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_ENDPOINT=

# Realtime WebSocket Microservice
# REALTIME_SECRET has no default and must be set explicitly per environment —
# it is never allowed to fall back to APP_KEY (see RealtimeTokenService).
REALTIME_PORT=8080
REALTIME_HOST=0.0.0.0
REALTIME_SECRET=change-me-generate-a-random-secret-per-environment
REALTIME_WS_URL=ws://127.0.0.1:8080

# WebRTC Media Plane (LiveKit SFU) — point at your own LiveKit instance
LIVEKIT_URL=http://localhost:7880
LIVEKIT_HOST=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change-me-generate-a-random-secret-per-environment

# STUN / TURN Infrastructure (Coturn) — point at your own TURN server
TURN_URL=turn:127.0.0.1:3478
TURN_USERNAME=change-me
TURN_CREDENTIAL=change-me

# Super Admin Root Access — leave empty by default; unset means no email
# gets Super Admin automatically. Set per environment, never commit a real
# address here.
SUPER_ADMIN_EMAILS=

# Multi-tenancy — flag-gated global scope (see config/tenancy.php, Architecture
# Audit §7/§15, ADR-002). Defaults to false: purely additive, zero behavior
# change until explicitly enabled per environment.
TENANCY_ENFORCE_GLOBAL_SCOPE=false

# CORS — comma-separated browser origins allowed to call /api/* cross-origin
# (see config/cors.php). Empty = same-origin only, which is the default.
CORS_ALLOWED_ORIGINS=
CORS_SUPPORTS_CREDENTIALS=false

VITE_APP_NAME="${APP_NAME}"
