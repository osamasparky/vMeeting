includes:
    - vendor/larastan/larastan/extension.neon
    # Known findings as of 2026-10-14 (mostly selectRaw aggregates and env() fallbacks); new code may not add more.
    - phpstan-baseline.neon

parameters:
    paths:
        - app

    # Level 2 focuses on syntax, undefined methods/properties, and critical type mismatches
    level: 2
